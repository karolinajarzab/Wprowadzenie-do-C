#include <iostream>
#include <string>
using namespace std;

string c = "";
string inicjaly(string a) {
    c = c + a[0];
    for(int i=1; i < a.length(); ++i) {
        if (a[i] == '_') {
            c = c + a[++i];
        }
    }
    cout << c << endl;
    return 0;
}

int main() {
    inicjaly("adam_kowalski");
}

