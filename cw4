#include <iostream>
#include <string>
using namespace std;

int main() {
    string dna = "ATGCGATATCGGATCGA";
    int A = 0;
    int T = 0;
    int G = 0;
    int C = 0;
    for (int i = 0; i < dna.length(); ++i) {
        if (dna[i] == 'A') A++;
        else if (dna[i] == 'T') T++;
        else if (dna[i] == 'G') G++;
        else if (dna[i] == 'C') C++;
    }

    cout << "A: " << A << endl;
    cout << "T: " << T << endl;
    cout << "G: " << G << endl;
    cout << "C: " << C << endl;

    return 0;
}

