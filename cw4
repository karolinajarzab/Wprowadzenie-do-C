//zad 1
#include <iostream>
#include <string>
using namespace std;

double x = 0;
double fold_change(double a, double b) {
    if(b == 0) {
        cout << x << endl;
    }
    else if(a < 0 || b < 0) {
        x = -1;
        cout << x << endl;
    }
    else {
        x = a / b;
        cout << x << endl;
    }
    return 0;
}

int main() {
    double c;
    double d;
    cout << "Wprowadź pierwszą liczbę: " << endl;
    cin >> c;
    cout << "Wprowadź drugą liczbę: " << endl;
    cin >> d;
    fold_change(c, d);
}

