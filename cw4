//zad4
#include <iostream>
#include <string>
using namespace std;

int main() {
    string input;
    cout << "Enter a string: ";
    cin >> input;
    int g = 0;
    int c = 0;
    float s = 0;
    for (int i = 0; i < input.length(); ++i) {
        if (input[i] == 'G') g++;
        else if (input[i] == 'C') c++;
        ++s;
    }
    cout << "Liczba G: " << g << endl;
    cout << "Liczba C: " << c << endl;
    cout << "Zawartosc GC w sekwencji: " << (g + c) / s * 100 << "%" << endl;
    return 0;
}

