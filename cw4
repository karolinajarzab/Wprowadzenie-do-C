string odwrot = "";
string odwrocenie(string a) {
    int len = a.length();
    for(int i=len-1; i > 0; i--) {
        odwrot = odwrot + a[i];
    }
    cout << odwrot << endl;
    return 0;
}

int main() {
    odwrocenie("adam_kowalski");
}

